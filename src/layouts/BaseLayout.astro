---
import "../styles/global.css";
const {
  title = "PawPass",
  description = "Identificación digital para mascotas.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head
    ><meta charset="UTF-8" /><meta
      name="viewport"
      content="width=device-width"
    /><meta name="description" content={description} /><title>
      {title}
    </title><link rel="icon" type="image/png" sizes="64x64" href={`${import.meta.env.BASE_URL}favicon.png`} /><base href={import.meta.env.BASE_URL} /><script
      src={`${import.meta.env.BASE_URL}firebase-config.js`}></script></head
  ><body><slot /></body>
</html>
