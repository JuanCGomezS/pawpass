---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout title="Ingresar — PawPass"
  ><Nav /><main class="login-wrap">
    <h1>Bienvenido a PawPass</h1><p>
      Ingresa o crea tu acceso. Tu cuenta recibirá permisos cuando el superadmin
      te asigne una cuenta de mascotas.
    </p><form class="panel" data-email-form>
      <div class="field">
        <label for="email">Correo electrónico</label><input
          id="email"
          type="email"
          placeholder="tu@correo.com"
          required
        />
      </div><div class="field" style="margin-top:14px">
        <label for="password">Contraseña</label><input
          id="password"
          type="password"
          placeholder="Mínimo 6 caracteres"
          required
        />
      </div><button
        class="button"
        style="width:100%;margin-top:20px"
        type="submit">Continuar con correo</button
      >
    </form><div class="panel" style="margin-top:14px">
      <button
        class="button button-outline"
        style="width:100%"
        type="button"
        data-google-sign-in>Continuar con Google</button
      ><p class="small" aria-live="polite" data-auth-message>
        Configura Firebase Authentication para activar el acceso.
      </p>
    </div>
  </main><script>
    import { signInWithGoogle } from "../lib/auth";
    import { observeSession } from "../lib/session";
    observeSession((state) => {
      if (state.status === "signed-in")
        window.location.assign(`${import.meta.env.BASE_URL}mis-mascotas/`);
    });
    const message = document.querySelector<HTMLElement>("[data-auth-message]");
    document
      .querySelector("[data-email-form]")
      ?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (message)
          message.textContent =
            "El acceso por correo se habilitará al conectar Firebase Authentication.";
      });
    document
      .querySelector<HTMLButtonElement>("[data-google-sign-in]")
      ?.addEventListener("click", async (event) => {
        const button = event.currentTarget as HTMLButtonElement;
        button.disabled = true;
        if (message) message.textContent = "Abriendo Google…";
        try {
          const result = await signInWithGoogle();
          if (result.ok) {
            window.location.assign(`${import.meta.env.BASE_URL}mis-mascotas/`);
            return;
          }
          if (message) message.textContent = result.message;
        } catch {
          if (message)
            message.textContent =
              "Ocurrió un error inesperado al abrir Google.";
        } finally {
          button.disabled = false;
        }
      });
  </script></BaseLayout
>
