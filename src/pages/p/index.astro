---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/pet-profile.css";
import "leaflet/dist/leaflet.css";
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Una pequeña gran historia — PawPass">
  <main class="pet-public">
    <p class="sr-only" role="status" data-profile-announcement></p>
    <article data-public-profile hidden>
      <section
        class="pet-cover"
        aria-label="Identidad de la mascota"
        data-cover
      >
        <header class="pet-cover-header">
          <a href={base} aria-label="Inicio de PawPass"
            ><img
              src={`${base}logo_horizontal.png`}
              alt="PawPass"
              width="2172"
              height="724"
            /></a
          ><a class="cover-index" data-section-link="historia" href="#historia"
            >Conoce mi historia <span aria-hidden="true">↓</span></a
          >
        </header>
        <div class="pet-portrait">
          <svg
            class="paw-trail paw-trail-one"
            viewBox="0 0 100 100"
            aria-hidden="true"
            ><ellipse
              cx="24"
              cy="30"
              rx="10"
              ry="15"
              transform="rotate(-25 24 30)"></ellipse><ellipse
              cx="47"
              cy="20"
              rx="10"
              ry="15"></ellipse><ellipse
              cx="70"
              cy="30"
              rx="10"
              ry="15"
              transform="rotate(25 70 30)"></ellipse><path
              d="M26 67c0-12 13-27 22-27s23 15 23 27c0 20-13 9-23 9s-22 11-22-9Z"
            ></path></svg
          >
          <svg
            class="paw-trail paw-trail-two"
            viewBox="0 0 100 100"
            aria-hidden="true"
            ><ellipse
              cx="24"
              cy="30"
              rx="10"
              ry="15"
              transform="rotate(-25 24 30)"></ellipse><ellipse
              cx="47"
              cy="20"
              rx="10"
              ry="15"></ellipse><ellipse
              cx="70"
              cy="30"
              rx="10"
              ry="15"
              transform="rotate(25 70 30)"></ellipse><path
              d="M26 67c0-12 13-27 22-27s23 15 23 27c0 20-13 9-23 9s-22 11-22-9Z"
            ></path></svg
          >
          <div class="portrait-copy">
            <h1 class="pet-cover-name" data-public-name></h1><p
              class="portrait-note"
            >
              Una pequeña<br /> gran historia.
            </p><div class="portrait-caption">
              <span data-public-species></span><span data-public-age></span>
            </div>
          </div>
          <div class="pet-cover-photo" data-public-photo hidden></div>
        </div>
        <svg
          class="cover-shape cover-shape-top"
          viewBox="0 0 300 250"
          aria-hidden="true"
          ><path d="M0 0h280c25 80-113 78-140 137S91 252 0 248Z"></path></svg
        >
        <svg
          class="cover-shape cover-shape-bottom"
          viewBox="0 0 300 250"
          aria-hidden="true"
          ><path d="M300 250H0c-4-91 128-51 153-120S234 20 300 0Z"></path></svg
        >
        <footer class="pet-cover-bottom">
          <p>Mi identidad.<br /><strong>Mi lugar en tu mundo.</strong></p><a
            class="pet-contact-action"
            data-hero-contact
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Contactar a mi persona por WhatsApp (abre una nueva pestaña)"
            hidden
            ><svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
              ></path></svg
            >Contactar a mi persona</a
          ><a
            class="cover-scroll"
            data-section-link="historia"
            href="#historia"
            aria-label="Ver información de la mascota"
            ><svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M12 4v15m-6-6 6 6 6-6"></path></svg
            ></a
          >
        </footer>
      </section>
      <div class="pet-story" id="historia">
        <section
          class="story-identification"
          data-identification
          hidden
          aria-labelledby="identification-title"
        >
          <div class="identification-heading">
            <div>
              <h2 id="identification-title">Identificación</h2><p>
                Su pequeña credencial, lista para llevar contigo.
              </p>
            </div>
            <a class="button" data-id-download hidden
              ><svg
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                ><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5"></path></svg
              >Descargar identificación</a
            >
          </div>
          <p data-id-status role="status"></p>
          <button
            class="button button-outline"
            type="button"
            data-id-retry
            hidden>Volver a intentar</button
          >
          <a
            class="identification-preview"
            data-id-full
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir identificación en tamaño completo"
            hidden><img data-id-image width="1536" height="960" alt="" /></a
          >
        </section>
        <section class="story-intro" data-about-section hidden>
          <div>
            <h2>Mucho más<br />que un nombre.</h2><p data-public-notes hidden>
            </p>
          </div>
          <dl class="pet-facts" data-public-facts></dl>
        </section>
        <section class="story-contact" data-contact-section hidden>
          <div>
            <h2>Mi gente.<br />Mi hogar.</h2><p>
              Si necesitas avisar algo sobre mí, aquí está la información que mi
              responsable decidió compartir.
            </p>
          </div>
          <div class="contact-details">
            <div data-public-contact hidden>
              <span>Mi persona</span><h3 data-guardian></h3><a data-phone hidden
              ></a>
            </div><div data-public-location hidden>
              <span>Por aquí está mi hogar</span><p data-location-label></p><div
                class="public-location-map"
                data-public-map
                hidden
                aria-label="Mapa de ubicación aproximada"
              >
              </div><p class="small" data-map-status role="status"></p><a
                data-map-link
                target="_blank"
                rel="noopener noreferrer"
                hidden>Ver ubicación aproximada</a
              >
            </div>
          </div>
        </section>
        <section class="story-health" data-health-section hidden>
          <div class="story-health-heading">
            <h2>Las huellas<br />de mi cuidado.</h2><p>
              Una historia de vacunas, visitas y pequeños cuidados. Sólo los
              registros que mi responsable eligió compartir.
            </p>
          </div>
          <div class="health-notes" data-health-notes></div>
          <p class="small" role="status" data-health-status></p>
          <div data-public-records></div>
          <p class="care-disclaimer">
            Información registrada por la persona responsable. No reemplaza una
            valoración veterinaria.
          </p>
        </section>
        <section class="pet-join" aria-labelledby="pet-join-title">
          <div>
            <h2 id="pet-join-title">
              ¿Tienes una mascota que deseas registrar?
            </h2>
            <p>
              Su historia también merece un lugar. Dale su propio espacio en
              PawPass, con una ficha pública y una identificación para llevar
              contigo.
            </p>
          </div>
          <a class="button pet-join-action" href={`${base}`}>
            Quiero registrar mi mascota
          </a>
        </section>
        <footer class="pet-story-footer">
          <a href={base}
            ><img
              src={`${base}logo_horizontal.png`}
              alt="PawPass"
              width="2172"
              height="724"
            /></a
          ><p>Una pequeña gran historia.<br />Compartida con cuidado.</p>
        </footer>
      </div>
    </article>
    <section class="public-empty" data-public-empty role="status">
      <a href={base}
        ><img
          class="empty-brand"
          src={`${base}logo_horizontal.png`}
          alt="PawPass"
          width="2172"
          height="724"
        /></a
      ><h1 data-state-title>Buscando una pequeña gran historia…</h1><p
        data-state-detail
      >
        Un momento mientras abrimos la ficha.
      </p><a class="button button-outline" href={base}>Conocer PawPass</a>
    </section>
  </main>
  <script>
    import "../../lib/public-profile";
  </script>
</BaseLayout>
