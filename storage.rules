rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isSuperadmin() { return signedIn() && request.auth.token.role == 'superadmin'; }
    function ownsPet(petId) {
      let pet = firestore.get(/databases/(default)/documents/pets/$(petId));
      let account = firestore.get(/databases/(default)/documents/accounts/$(pet.data.accountId));
      return signedIn() && account.data.adminUid == request.auth.uid;
    }
    match /pets/{petId}/profile/{fileId} {
      allow read: if ownsPet(petId) || isSuperadmin();
      allow create: if (ownsPet(petId) || isSuperadmin()) &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update: if false;
      allow delete: if ownsPet(petId) || isSuperadmin();
    }
  }
}
